# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/derit

# Session
SESSION_SECRET=your-session-secret-here
# Set true when the public frontend uses HTTPS. Leave unset to infer from
# FRONTEND_URL; this keeps local production-container access over HTTP working.
# SESSION_COOKIE_SECURE=true

# CORS
FRONTEND_URL=http://localhost:5173

# Google OAuth
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=http://localhost:5001/auth/google/callback

# nsjail Code Execution (replaces Docker executor)
# Path to nsjail binary
NSJAIL_PATH=/usr/bin/nsjail
# Directory containing nsjail config files
NSJAIL_CONFIG_DIR=./apps/server/config
# Workspace directory for code execution
NSJAIL_WORKSPACE_DIR=./temp/nsjail-workspace
# Set true for WSL/local environments where nsjail mount namespaces cannot see host binaries
NSJAIL_DISABLE_NEWNS=false
# Set true only when the configured database is safe for E2E seeding/cleanup
E2E_ALLOW_DB_MUTATION=false
# Java home path
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
# Python binary path
PYTHON_BIN=/usr/bin/python3
# Max concurrent executions (adjust based on VPS resources)
NSJAIL_MAX_CONCURRENT=4
# Memory limit per execution in MB
NSJAIL_MEMORY_LIMIT_MB=512
# Execution timeout per testcase in ms
RUN_TIMEOUT=5000
# Compilation timeout in ms
COMPILE_TIMEOUT=10000

# ===========================================
# Cloudflare R2 Object Storage
# ===========================================
# Cloudflare Account ID (found on Cloudflare dashboard or R2 overview)
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 API Token Access Key ID
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 API Token Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Target R2 Bucket Name
R2_BUCKET_NAME=derit-storage
# Public URL / Custom Domain configured for the bucket (used to construct public file URLs)
# e.g., https://pub-xxxxxxxxxxxxxxxx.r2.dev or https://assets.yourdomain.com
R2_PUBLIC_URL=https://pub-your-r2-subdomain.r2.dev
# Optional: custom endpoint if different from https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
