# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/derit

# Session
SESSION_SECRET=your-session-secret-here

# CORS
FRONTEND_URL=http://localhost:3000

# Google OAuth
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=http://localhost:5001/auth/google/callback

# nsjail Code Execution (replaces Docker executor)
# Path to nsjail binary
NSJAIL_PATH=/usr/bin/nsjail
# Directory containing nsjail config files
NSJAIL_CONFIG_DIR=./apps/server/config
# Workspace directory for code execution
NSJAIL_WORKSPACE_DIR=./temp/nsjail-workspace
# Java home path
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
# Python binary path
PYTHON_BIN=/usr/bin/python3
# Max concurrent executions (adjust based on VPS resources)
NSJAIL_MAX_CONCURRENT=4
# Memory limit per execution in MB
NSJAIL_MEMORY_LIMIT_MB=512
# Execution timeout per testcase in ms
RUN_TIMEOUT=5000
# Compilation timeout in ms
COMPILE_TIMEOUT=10000
