# ===========================================
# DERIT - Root Environment Variables
# ===========================================

# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/derit

# Session
SESSION_SECRET=your-session-secret-here

# CORS
FRONTEND_URL=http://localhost:5173

# Google OAuth
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=http://localhost:5001/auth/google/callback

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=derit-storage
R2_PUBLIC_URL=https://pub-your-r2-subdomain.r2.dev

# ===========================================
# App-specific (apps/server/.env)
# ===========================================
# Copy this to apps/server/.env

# ===========================================
# App-specific (apps/web/.env)
# ===========================================
# VITE_DEV_BACKEND_URL=http://localhost:5001
# VITE_BACKEND_URL=http://localhost:5001

